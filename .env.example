# Environment variables for local development
# Copy this file to .env.local and add your actual API keys

# Gemini AI API Key (get from Google AI Studio)
GEMINI_API_KEY=your_ai_api_key_here

# OpenWeatherMap API Key (get from openweathermap.org)
WEATHER_API_KEY=your_weather_api_key_here

# Note: For Vercel deployment, set these as environment variables in your Vercel dashboard
# The REACT_APP_ prefixed variables are no longer needed as API keys are now server-side only